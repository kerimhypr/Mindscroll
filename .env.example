# ChronosFeed Environment Variables Configuration Example
# Copy this file to .env.local and fill in your values.

# ==========================================
# 1. STRIPE CONFIGURATION
# ==========================================
# Retrieve these keys from your Stripe Dashboard -> Developers -> API Keys
# Local mock checkout will run automatically if these variables are left empty.
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# ==========================================
# 2. FIREBASE CONFIGURATION (Already integrated client-side)
# ==========================================
# Client-side configuration is hardcoded in src/lib/firebase.ts as requested,
# but can be customized here if needed.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=chronosfeed
